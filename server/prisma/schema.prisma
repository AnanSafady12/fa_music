generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Instrument {
  Piano
  Oud
  Guitar
  Aorg
  Drums
  Darbuka
  Singing
  Qanon
  Kaman
  Cello
}

model Student {
  id               Int        @id @default(autoincrement())
  name             String
  parentName       String?
  phone            String?
  phone2           String?
  age              Int?
  instrument       Instrument?
  totalLessons     Int        @default(0)
  completedLessons Float      @default(0)
  hasPaid          Boolean    @default(false)
  amountPaid       Float      @default(0)
  paidPacks        String     @default("")
  notes            String?
  registrationDate DateTime   @default(now())
  lessons          Lesson[]
  todos            Todo[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Teacher {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String?
  instrument    Instrument?
  costPerLesson Float    @default(0)
  rooms         Room[]
  monthlyStats  MonthlyTeacherStats[]
  lessons       Lesson[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MonthlyTeacherStats {
  id           Int      @id @default(autoincrement())
  teacherId    Int
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  month        Int
  year         Int
  notes        String?
  manualSalary Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([teacherId, month, year])
}

model Worker {
  id           Int         @id @default(autoincrement())
  name         String      @default("Worker")
  costPerHour  Float       @default(0)
  totalHours   Float       @default(0)
  logs         WorkerLog[]
  updatedAt    DateTime    @updatedAt
}

model WorkerLog {
  id          Int      @id @default(autoincrement())
  workerId    Int
  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date        DateTime
  hours       Float
  costPerHour Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Schedule {
  id        Int      @id @default(autoincrement())
  dayName   String
  date      DateTime @unique
  rooms     Room[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id         Int      @id @default(autoincrement())
  name       String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId Int
  teacher    Teacher? @relation(fields: [teacherId], references: [id])
  teacherId  Int?
  lessons    Lesson[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Lesson {
  id        Int      @id @default(autoincrement())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    Int
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId Int?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId Int?
  startTime String
  endTime   String
  made      Boolean  @default(true)
  isProcessed Boolean @default(false)
  reminderSent Boolean @default(false)
  isBreak   Boolean  @default(false)
  breakLabel String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Todo {
  id          Int      @id @default(autoincrement())
  text        String
  isCompleted Boolean  @default(false)
  student     Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

